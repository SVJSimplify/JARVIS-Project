{
  "name": "jarvis-electron",
  "version": "1.0.0",
  "description": "JINI — personal intelligence desktop (formerly JARVIS)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "predev:main": "node scripts/cleanStale.mjs",
    "dev:main": "npm run build:dev && electron . --no-sandbox",
    "prebuild:dev": "node scripts/cleanStale.mjs",
    "build:dev": "npm run build:dev:main && npm run build:dev:preload",
    "build:dev:main": "tsc -p tsconfig.node.json --outDir dist/main",
    "build:dev:preload": "tsc src/preload/index.ts --outDir dist/preload --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder",
    "prebuild": "node scripts/cleanStale.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json --outDir dist/main",
    "build:preload": "tsc src/preload/index.ts --outDir dist/preload --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck",
    "start": "npm run build:preload && npm run dev:main",
    "lint": "eslint src",
    "pretypecheck": "node scripts/cleanStale.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.jini.desktop",
    "productName": "JINI",
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "autoprefixer": "^10.0.0",
    "docx": "^9.15.1",
    "electron-store": "^10.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.0.0",
    "jszip": "^3.10.2",
    "msedge-tts": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "31.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "author": "Jarvis"
}
