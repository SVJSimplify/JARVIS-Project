{
  "name": "jarvis-electron",
  "version": "1.0.0",
  "description": "JARVIS Desktop Assistant",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "npm run build:dev && electron . --no-sandbox",
    "build:dev": "npm run build:dev:main && npm run build:dev:preload",
    "build:dev:main": "tsc -p tsconfig.node.json --outDir dist/main",
    "build:dev:preload": "tsc src/preload/index.ts --outDir dist/preload --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json --outDir dist/main",
    "build:preload": "tsc src/preload/index.ts --outDir dist/preload --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck",
    "start": "npm run build:preload && npm run dev:main",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "autoprefixer": "^10.0.0",
    "electron-store": "^10.1.0",
    "framer-motion": "^11.0.0",
    "msedge-tts": "^2.1.1",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "author": "Jarvis"
}
